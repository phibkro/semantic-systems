{
  "name": "semantic-systems",
  "version": "0.0.0",
  "private": true,
  "description": "Development-control-loop tooling for the Semantic Systems monorepo.",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "bun scripts/install-git-hooks.ts",
    "commitlint": "commitlint",
    "hooks:install": "bun scripts/install-git-hooks.ts",
    "format:check": "oxfmt --check scripts commitlint.config.ts package.json tsconfig.json",
    "lint": "oxlint --deny-warnings scripts commitlint.config.ts package.json tsconfig.json",
    "typecheck": "tsc --noEmit",
    "check-commit-policy": "bun scripts/check-commit-policy.ts",
    "control-room:check": "bun run --cwd apps/control-room check",
    "control-room:preview": "bun run --cwd apps/control-room serve:preview"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/bun": "^1.3.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "typescript": "7.0.2"
  }
}
