{
  "name": "semantic-systems",
  "version": "0.0.0",
  "private": true,
  "description": "Development-control-loop tooling for the Semantic Systems monorepo.",
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "bun scripts/install-git-hooks.ts",
    "commitlint": "commitlint",
    "hooks:install": "bun scripts/install-git-hooks.ts",
    "semproj": "bun src/project-model/main-bun.ts",
    "semproj:node": "node src/project-model/main-node.ts",
    "semantic-tracer": "bun src/tracer/main-bun.ts",
    "semantic-tracer:node": "node src/tracer/main-node.ts",
    "semantic-actor": "bun src/actor/main-bun.ts",
    "semantic-actor:node": "node src/actor/main-node.ts",
    "test": "bun test",
    "test:project-model": "bun test tests/project-model.test.ts",
    "fast": "bun scripts/check-fast.ts",
    "check": "bun scripts/check.ts",
    "check:references": "bun scripts/check-references.ts",
    "control-room:check": "bun run --cwd apps/control-room check",
    "control-room:preview": "bun run --cwd apps/control-room preview",
    "effect:setup": "bun scripts/setup-effect-tsgo.ts",
    "format:check": "oxfmt --check src tests scripts apps commitlint.config.ts package.json tsconfig.json",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives src tests scripts apps commitlint.config.ts package.json tsconfig.json",
    "typecheck": "tsc --noEmit",
    "check-commit-policy": "bun scripts/check-commit-policy.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.102",
    "@effect/platform-node": "4.0.0-beta.102",
    "effect": "4.0.0-beta.102",
    "toml": "4.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@effect/tsgo": "0.24.3",
    "@types/bun": "^1.3.0",
    "@types/css-tree": "2.3.11",
    "@types/mdast": "4.0.4",
    "css-tree": "3.2.1",
    "effect-oxlint": "0.3.3",
    "mdast-util-from-markdown": "2.0.2",
    "micromark": "4.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "parse5": "8.0.1",
    "typescript": "7.0.2"
  },
  "optionalDependencies": {
    "@effect/tsgo-linux-x64": "0.24.3",
    "@typescript/typescript-linux-x64": "7.0.2"
  },
  "packageManager": "bun@1.3.13"
}
