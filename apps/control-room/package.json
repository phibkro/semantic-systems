{
  "name": "control-room",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "format": "oxfmt --write src e2e index.html vite.config.ts vitest.config.ts playwright.config.mjs serve-preview.mjs",
    "format:check": "oxfmt --check src e2e index.html vite.config.ts vitest.config.ts playwright.config.mjs serve-preview.mjs",
    "lint": "oxlint --deny-warnings src e2e vite.config.ts vitest.config.ts playwright.config.mjs serve-preview.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "serve:preview": "bun serve-preview.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@tailwindcss/vite": "4.1.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "radix-ui": "1.6.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.1.18",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "28.0.0",
    "oxfmt": "0.36.0",
    "oxlint": "1.71.0",
    "typescript": "7.0.2",
    "vite": "8.1.1",
    "vite-plugin-pwa": "1.2.0",
    "vitest": "4.0.18"
  }
}
