{
  "name": "@semantic-systems/control-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun tooling/export-public-data.ts && vite --host 127.0.0.1",
    "export:data": "bun tooling/export-public-data.ts",
    "build": "bun run export:data && vite build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run scan",
    "format": "oxfmt --write src e2e tooling index.html alchemy.run.ts vite.config.ts vitest.config.ts playwright.config.ts",
    "format:check": "oxfmt --check src e2e tooling index.html alchemy.run.ts vite.config.ts vitest.config.ts playwright.config.ts",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives src e2e tooling alchemy.run.ts vite.config.ts vitest.config.ts playwright.config.ts",
    "preview": "bun tooling/serve-preview.ts",
    "scan": "bun tooling/scan-public-payload.ts",
    "test": "vitest run",
    "test:browser": "bun run build && playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@xstate/react": "^6.1.0",
    "@xyflow/react": "^12.11.2",
    "alchemy": "2.0.0-beta.64",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.0-beta.102",
    "lucide-react": "^1.28.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xstate": "^5.32.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@effect/platform-node": "4.0.0-beta.102",
    "@playwright/test": "1.61.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/bun": "1.3.9",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "axe-core": "^4.12.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "fast-glob": "3.3.3",
    "jsdom": "28.0.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "shadcn": "^4.16.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.1",
    "vite-plugin-pwa": "1.2.0",
    "vitest": "4.0.18",
    "workbox-window": "7.4.1",
    "yaml": "2.9.0"
  }
}
