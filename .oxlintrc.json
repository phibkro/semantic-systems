{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "react", "jsx-a11y"],
  "jsPlugins": ["./scripts/oxlint/semantic-effect-rules.ts"],
  "rules": {
    "eqeqeq": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": ["useEffect"],
            "message": "Model lifecycles as XState callback actors or library-owned subscriptions. A rare adapter exception belongs under src/adapters with a reviewed local override."
          }
        ]
      }
    ],
    "no-await-in-loop": "off",
    "no-throw-literal": "error",
    "promise/always-return": "off",
    "promise/no-multiple-resolved": "error",
    "react/exhaustive-deps": "error",
    "react/react-compiler": "error",
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "semantic-effect/ambient-console": "error",
    "semantic-effect/ambient-nondeterminism": "error",
    "semantic-effect/effect-runtime-boundary": "error",
    "semantic-effect/portable-runtime-imports": "error",
    "semantic-effect/schema-json-boundary": "error",
    "semantic-effect/typed-failure-boundary": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "unicorn/no-array-reverse": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/prefer-node-protocol": "error"
  },
  "overrides": [
    {
      "files": ["tests/**/*.ts"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ]
}
