{
  "schema_version": 1,
  "kind": "conformance_suite",
  "id": "suite.inventory.v0",
  "name": "Inventory v0 example conformance suite",
  "theory": "theory.inventory",
  "theory_identity": "sha256:456b5f8d991ce08c400c6b1688216834ad0460ab57ad14ef99cb5b4866a158ba",
  "obligation": "obligation.inventory.conformance",
  "category": "example_test",
  "producer": {
    "id": "semantic-tracer",
    "version": "0.2.0"
  },
  "assumptions": [
    "All fixture quantities stay within JavaScript's exact safe-integer range.",
    "The nine authored cases adequately sample the v0 contract for development selection."
  ],
  "cases": [
    {
      "id": "reserve-and-release",
      "initial_state": {
        "stock": {
          "apple": 5
        },
        "reservations": {}
      },
      "steps": [
        {
          "message": {
            "kind": "Reserve",
            "item": "apple",
            "quantity": 2
          },
          "fresh_id": "r-001"
        },
        {
          "message": {
            "kind": "Release",
            "reservation_id": "r-001"
          }
        }
      ],
      "expected_events": [
        {
          "kind": "Reserved",
          "reservation_id": "r-001",
          "item": "apple",
          "quantity": 2
        },
        {
          "kind": "Released",
          "reservation_id": "r-001"
        }
      ],
      "expected_final_state": {
        "stock": {
          "apple": 5
        },
        "reservations": {}
      }
    },
    {
      "id": "insufficient-stock",
      "initial_state": {
        "stock": {
          "apple": 1
        },
        "reservations": {}
      },
      "steps": [
        {
          "message": {
            "kind": "Reserve",
            "item": "apple",
            "quantity": 2
          },
          "fresh_id": "r-002"
        }
      ],
      "expected_events": [
        {
          "kind": "ReservationRejected",
          "item": "apple",
          "quantity": 2,
          "reason": "insufficient_stock"
        }
      ],
      "expected_final_state": {
        "stock": {
          "apple": 1
        },
        "reservations": {}
      }
    },
    {
      "id": "invalid-zero-quantity",
      "initial_state": {
        "stock": {
          "apple": 3
        },
        "reservations": {}
      },
      "steps": [
        {
          "message": {
            "kind": "Reserve",
            "item": "apple",
            "quantity": 0
          }
        }
      ],
      "expected_events": [
        {
          "kind": "ReservationRejected",
          "item": "apple",
          "quantity": 0,
          "reason": "invalid_quantity"
        }
      ],
      "expected_final_state": {
        "stock": {
          "apple": 3
        },
        "reservations": {}
      }
    },
    {
      "id": "unknown-release",
      "initial_state": {
        "stock": {
          "apple": 3
        },
        "reservations": {}
      },
      "steps": [
        {
          "message": {
            "kind": "Release",
            "reservation_id": "missing"
          }
        }
      ],
      "expected_events": [
        {
          "kind": "ReleaseRejected",
          "reservation_id": "missing",
          "reason": "unknown_reservation"
        }
      ],
      "expected_final_state": {
        "stock": {
          "apple": 3
        },
        "reservations": {}
      }
    },
    {
      "id": "reserve-exact-boundary",
      "initial_state": {
        "stock": {
          "apple": 2
        },
        "reservations": {}
      },
      "steps": [
        {
          "message": {
            "kind": "Reserve",
            "item": "apple",
            "quantity": 2
          },
          "fresh_id": "r-003"
        }
      ],
      "expected_events": [
        {
          "kind": "Reserved",
          "reservation_id": "r-003",
          "item": "apple",
          "quantity": 2
        }
      ],
      "expected_final_state": {
        "stock": {
          "apple": 0
        },
        "reservations": {
          "r-003": {
            "item": "apple",
            "quantity": 2
          }
        }
      }
    },
    {
      "id": "duplicate-fresh-identifier",
      "initial_state": {
        "stock": {
          "apple": 5
        },
        "reservations": {}
      },
      "steps": [
        {
          "message": {
            "kind": "Reserve",
            "item": "apple",
            "quantity": 1
          },
          "fresh_id": "r-004"
        },
        {
          "message": {
            "kind": "Reserve",
            "item": "apple",
            "quantity": 1
          },
          "fresh_id": "r-004"
        }
      ],
      "expected_events": [
        {
          "kind": "Reserved",
          "reservation_id": "r-004",
          "item": "apple",
          "quantity": 1
        },
        {
          "kind": "ReservationRejected",
          "item": "apple",
          "quantity": 1,
          "reason": "duplicate_reservation_id"
        }
      ],
      "expected_final_state": {
        "stock": {
          "apple": 4
        },
        "reservations": {
          "r-004": {
            "item": "apple",
            "quantity": 1
          }
        }
      }
    },
    {
      "id": "missing-stock-is-zero",
      "initial_state": {
        "stock": {},
        "reservations": {}
      },
      "steps": [
        {
          "message": {
            "kind": "Reserve",
            "item": "pear",
            "quantity": 1
          },
          "fresh_id": "r-005"
        }
      ],
      "expected_events": [
        {
          "kind": "ReservationRejected",
          "item": "pear",
          "quantity": 1,
          "reason": "insufficient_stock"
        }
      ],
      "expected_final_state": {
        "stock": {},
        "reservations": {}
      }
    },
    {
      "id": "invalid-negative-quantity",
      "initial_state": {
        "stock": {
          "apple": 3
        },
        "reservations": {}
      },
      "steps": [
        {
          "message": {
            "kind": "Reserve",
            "item": "apple",
            "quantity": -1
          }
        }
      ],
      "expected_events": [
        {
          "kind": "ReservationRejected",
          "item": "apple",
          "quantity": -1,
          "reason": "invalid_quantity"
        }
      ],
      "expected_final_state": {
        "stock": {
          "apple": 3
        },
        "reservations": {}
      }
    },
    {
      "id": "release-twice",
      "initial_state": {
        "stock": {
          "apple": 2
        },
        "reservations": {}
      },
      "steps": [
        {
          "message": {
            "kind": "Reserve",
            "item": "apple",
            "quantity": 1
          },
          "fresh_id": "r-006"
        },
        {
          "message": {
            "kind": "Release",
            "reservation_id": "r-006"
          }
        },
        {
          "message": {
            "kind": "Release",
            "reservation_id": "r-006"
          }
        }
      ],
      "expected_events": [
        {
          "kind": "Reserved",
          "reservation_id": "r-006",
          "item": "apple",
          "quantity": 1
        },
        {
          "kind": "Released",
          "reservation_id": "r-006"
        },
        {
          "kind": "ReleaseRejected",
          "reservation_id": "r-006",
          "reason": "unknown_reservation"
        }
      ],
      "expected_final_state": {
        "stock": {
          "apple": 2
        },
        "reservations": {}
      }
    }
  ]
}
