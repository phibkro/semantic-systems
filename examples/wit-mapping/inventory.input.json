    "laws": [
      {
        "id": "rejection-is-noop",
        "statement": "Every rejected message emits one rejection event and leaves state unchanged."
      },
      {
        "id": "replay-agrees-with-transition",
        "statement": "Replaying emitted events from the initial state reconstructs the transition final state."
      }
    ],
    "effect_labels": [
      {
        "id": "effect.fresh",
        "statement": "Fresh reservation identifiers are unique within one execution."
      },
      {
        "id": "effect.clock",
        "statement": "The inventory clock is an external capability."
      }
    ],
    "usage_grades": [
      {
        "id": "linear",
        "statement": "Reservation handles are consumed at most once."
      }
    ],
    "assumptions": [
      {
        "id": "inventory.initial-state",
        "statement": "The initial inventory state satisfies the non-negative stock invariant."
      }
    ],
    "evidence_requirements": [
      {
        "id": "inventory.conformance",
        "statement": "A realization must provide an independently checked conformance trace."
      }
    ]
