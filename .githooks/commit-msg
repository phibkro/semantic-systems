#!/usr/bin/env bun
import { statSync } from "node:fs";
const childExitCode = (
  command: ReadonlyArray<string>,
  result: { readonly exitCode: number | null; readonly signalCode?: string | null },
): number => {
  if (result.signalCode !== undefined && result.signalCode !== null) {
    console.error(
      `commit-msg: ${command.join(" ")} was terminated by signal ${result.signalCode}.`,
    );
    return 1;
  }
  if (result.exitCode === null) {
    console.error(`commit-msg: ${command.join(" ")} terminated without an exit code.`);
    return 1;
  }
  return result.exitCode;
};

const rootCommand = ["git", "rev-parse", "--show-toplevel"];
const rootResult = Bun.spawnSync(rootCommand);
const rootExitCode = childExitCode(rootCommand, rootResult);
if (rootExitCode !== 0) {
  process.stderr.write(rootResult.stderr);
  process.exit(rootExitCode);
}
const root = rootResult.stdout.toString().trim();
const commitlint = `${root}/node_modules/.bin/commitlint`;
try {
  if ((statSync(commitlint).mode & 0o111) === 0) throw new Error("not executable");
} catch {
  console.error(
    "commit-msg: dependencies are missing; run 'bun install --frozen-lockfile'.",
  );
  process.exit(1);
}

const commitlintCommand = [commitlint, "--edit", Bun.argv[2] ?? ""];
const result = Bun.spawnSync({
  cmd: commitlintCommand,
  cwd: root,
  stdin: "inherit",
  stdout: "inherit",
  stderr: "inherit",
});
process.exit(childExitCode(commitlintCommand, result));
