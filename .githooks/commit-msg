#!/usr/bin/env bun
import { statSync } from "node:fs";

const rootResult = Bun.spawnSync(["git", "rev-parse", "--show-toplevel"]);
if (rootResult.exitCode !== 0) {
  process.stderr.write(rootResult.stderr);
  process.exit(rootResult.exitCode);
}
const root = rootResult.stdout.toString().trim();
const commitlint = `${root}/node_modules/.bin/commitlint`;
try {
  if ((statSync(commitlint).mode & 0o111) === 0) throw new Error("not executable");
} catch {
  console.error(
    "commit-msg: dependencies are missing; run 'bun install --frozen-lockfile'.",
  );
  process.exit(1);
}

const result = Bun.spawnSync({
  cmd: [commitlint, "--edit", Bun.argv[2] ?? ""],
  cwd: root,
  stdin: "inherit",
  stdout: "inherit",
  stderr: "inherit",
});
process.exit(result.exitCode);
