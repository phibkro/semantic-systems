#!/usr/bin/env bun
const rootResult = Bun.spawnSync(["git", "rev-parse", "--show-toplevel"]);
if (rootResult.exitCode !== 0) {
  process.stderr.write(rootResult.stderr);
  process.exit(rootResult.exitCode);
}
const root = rootResult.stdout.toString().trim();
const localVariables = Bun.spawnSync(["git", "rev-parse", "--local-env-vars"]);
if (localVariables.exitCode !== 0) {
  process.stderr.write(localVariables.stderr);
  process.exit(localVariables.exitCode);
}
const environment = { ...process.env };
for (const name of localVariables.stdout.toString().split(/\s+/).filter(Boolean)) {
  delete environment[name];
}
if (Bun.which("nix") === null) {
  console.error("pre-push: Nix is required for the pinned integration gate.");
  process.exit(1);
}

const result = Bun.spawnSync({
  cmd: ["nix", "develop", "--command", "bun", "scripts/check.ts"],
  cwd: root,
  env: environment,
  stdin: "inherit",
  stdout: "inherit",
  stderr: "inherit",
});
process.exit(result.exitCode);
