#!/usr/bin/env bun
import { statSync } from "node:fs";

const childExitCode = (
  command: ReadonlyArray<string>,
  result: { readonly exitCode: number | null; readonly signalCode?: string | null },
): number => {
  if (result.signalCode !== undefined && result.signalCode !== null) {
    console.error(
      `pre-commit: ${command.join(" ")} was terminated by signal ${result.signalCode}.`,
    );
    return 1;
  }
  if (result.exitCode === null) {
    console.error(`pre-commit: ${command.join(" ")} terminated without an exit code.`);
    return 1;
  }
  return result.exitCode;
};
const run = (
  command: ReadonlyArray<string>,
  options: { readonly cwd?: string; readonly capture?: boolean } = {},
) =>
  Bun.spawnSync({
    cmd: [...command],
    cwd: options.cwd,
    stdin: "inherit",
    stdout: options.capture ? "pipe" : "inherit",
    stderr: options.capture ? "pipe" : "inherit",
  });

const rootCommand = ["git", "rev-parse", "--show-toplevel"];
const rootResult = run(rootCommand, { capture: true });
const rootExitCode = childExitCode(rootCommand, rootResult);
if (rootExitCode !== 0) {
  process.stderr.write(rootResult.stderr);
  process.exit(rootExitCode);
}
const root = rootResult.stdout.toString().trim();
const oxfmt = `${root}/node_modules/.bin/oxfmt`;
const oxlint = `${root}/node_modules/.bin/oxlint`;
try {
  if ((statSync(oxfmt).mode & 0o111) === 0 || (statSync(oxlint).mode & 0o111) === 0) {
    throw new Error("not executable");
  }
} catch {
  console.error(
    "pre-commit: dependencies are missing; run 'bun install --frozen-lockfile'.",
  );
  process.exit(1);
}

const namesCommand = ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z"];
const names = run(namesCommand, {
  cwd: root,
  capture: true,
});
const namesExitCode = childExitCode(namesCommand, names);
if (namesExitCode !== 0) {
  process.stderr.write(names.stderr);
  process.exit(namesExitCode);
}
const files = names.stdout
  .toString()
  .split("\0")
  .filter((path) => path.length > 0);
const formatFiles: string[] = [];
const lintFiles: string[] = [];
const scriptPattern = /\.(?:js|jsx|ts|tsx|mjs|cjs|mts|cts)$/;
const dataPattern = /\.(?:json|jsonc|css|scss)$/;
// Clamor configuration materialization: *.js|*.jsx|*.ts|*.tsx|*.mjs|*.cjs|*.mts|*.cts
for (const file of files) {
  const diffCommand = ["git", "diff", "--quiet", "--", file];
  const diffResult = run(diffCommand, { cwd: root });
  const diffExitCode = childExitCode(diffCommand, diffResult);
  if (diffExitCode !== 0) {
    if (diffResult.exitCode === 1) {
      console.error(`pre-commit: ${file} has both staged and unstaged changes.`);
      console.error("Stage the exact artifact to validate, then commit again.");
    } else if (diffResult.stderr.length > 0) {
      process.stderr.write(diffResult.stderr);
    }
    process.exit(diffExitCode);
  }
  if (scriptPattern.test(file)) {
    formatFiles.push(file);
    lintFiles.push(file);
  } else if (dataPattern.test(file)) {
    formatFiles.push(file);
  }
}

for (const command of [
  ...(formatFiles.length > 0 ? [[oxfmt, "--check", ...formatFiles]] : []),
  ...(lintFiles.length > 0 ? [[oxlint, "--deny-warnings", ...lintFiles]] : []),
  ["bun", "scripts/check-fast.ts"],
]) {
  const result = run(command, { cwd: root });
  const exitCode = childExitCode(command, result);
  if (exitCode !== 0) process.exit(exitCode);
}
