{
  "servers": {
    "vscode-json-language-server": {
      "settings": {
        "json": {
          "schemas": [
            {
              "fileMatch": [
                "model/**/*.json"
              ],
              "schema": {
                "$defs": {
                  "FeatureMetadata": {
                    "additionalProperties": true,
                    "description": "Lifecycle-owned attributes for a managed feature work item.",
                    "properties": {
                      "completion": {
                        "additionalProperties": false,
                        "properties": {
                          "evidence": {
                            "items": {
                              "$ref": "#/$defs/Objects_"
                            },
                            "minItems": 1,
                            "prefixItems": [
                              {
                                "$ref": "#/$defs/Objects_"
                              }
                            ],
                            "type": "array"
                          },
                          "implementation_head": {
                            "allOf": [
                              {
                                "description": "a string matching the RegExp ^[0-9a-f]{40}$",
                                "pattern": "^[0-9a-f]{40}$"
                              }
                            ],
                            "type": "string"
                          },
                          "integration_head": {
                            "allOf": [
                              {
                                "description": "a string matching the RegExp ^[0-9a-f]{40}$",
                                "pattern": "^[0-9a-f]{40}$"
                              }
                            ],
                            "type": "string"
                          },
                          "outcome": {
                            "enum": [
                              "positive",
                              "negative"
                            ],
                            "type": "string"
                          }
                        },
                        "required": [
                          "outcome",
                          "evidence"
                        ],
                        "type": "object"
                      },
                      "feature_id": {
                        "allOf": [
                          {
                            "description": "a string matching the RegExp ^[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*$",
                            "pattern": "^[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*$"
                          }
                        ],
                        "type": "string"
                      },
                      "feature_loop": {
                        "enum": [
                          "managed",
                          "pre_loop"
                        ],
                        "type": "string"
                      },
                      "replacement": {
                        "additionalProperties": false,
                        "properties": {
                          "reason": {
                            "allOf": [
                              {
                                "description": "a value with a length of at least 1",
                                "minLength": 1
                              }
                            ],
                            "type": "string"
                          },
                          "target": {
                            "allOf": [
                              {
                                "description": "a value with a length of at least 1",
                                "minLength": 1
                              }
                            ],
                            "type": "string"
                          }
                        },
                        "required": [
                          "target",
                          "reason"
                        ],
                        "type": "object"
                      }
                    },
                    "type": "object"
                  },
                  "Objects_": {
                    "additionalProperties": false,
                    "properties": {
                      "category": {
                        "enum": [
                          "proof",
                          "derived",
                          "analysis",
                          "model_check",
                          "test",
                          "example_test",
                          "property_test",
                          "benchmark",
                          "runtime_check",
                          "assertion",
                          "assumption"
                        ],
                        "type": "string"
                      },
                      "claim": {
                        "allOf": [
                          {
                            "description": "a value with a length of at least 1",
                            "minLength": 1
                          }
                        ],
                        "type": "string"
                      },
                      "method": {
                        "allOf": [
                          {
                            "description": "a value with a length of at least 1",
                            "minLength": 1
                          }
                        ],
                        "type": "string"
                      },
                      "role": {
                        "enum": [
                          "feature_acceptance",
                          "integration_test",
                          "integration_analysis",
                          "equivalence",
                          "independent_review",
                          "status_basis"
                        ],
                        "type": "string"
                      },
                      "source": {
                        "anyOf": [
                          {
                            "additionalProperties": false,
                            "properties": {
                              "kind": {
                                "enum": [
                                  "repository_artifact"
                                ],
                                "type": "string"
                              },
                              "path": {
                                "allOf": [
                                  {
                                    "description": "a string matching the RegExp ^(?![\\\\/])(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$)).+$",
                                    "pattern": "^(?![\\\\/])(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$)).+$"
                                  }
                                ],
                                "type": "string"
                              }
                            },
                            "required": [
                              "kind",
                              "path"
                            ],
                            "type": "object"
                          },
                          {
                            "additionalProperties": false,
                            "properties": {
                              "kind": {
                                "enum": [
                                  "git_commit"
                                ],
                                "type": "string"
                              },
                              "object_id": {
                                "allOf": [
                                  {
                                    "description": "a string matching the RegExp ^[0-9a-f]{40}$",
                                    "pattern": "^[0-9a-f]{40}$"
                                  }
                                ],
                                "type": "string"
                              }
                            },
                            "required": [
                              "kind",
                              "object_id"
                            ],
                            "type": "object"
                          },
                          {
                            "additionalProperties": false,
                            "properties": {
                              "kind": {
                                "enum": [
                                  "external_observation"
                                ],
                                "type": "string"
                              },
                              "uri": {
                                "allOf": [
                                  {
                                    "description": "a string matching the RegExp ^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
                                    "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
                                  }
                                ],
                                "type": "string"
                              }
                            },
                            "required": [
                              "kind",
                              "uri"
                            ],
                            "type": "object"
                          },
                          {
                            "additionalProperties": false,
                            "properties": {
                              "kind": {
                                "enum": [
                                  "authored_assertion"
                                ],
                                "type": "string"
                              }
                            },
                            "required": [
                              "kind"
                            ],
                            "type": "object"
                          }
                        ]
                      }
                    },
                    "required": [
                      "role",
                      "category",
                      "method",
                      "source",
                      "claim"
                    ],
                    "type": "object"
                  },
                  "ProjectDocumentInput": {
                    "additionalProperties": false,
                    "description": "A canonical Semantic Systems project-model source document.",
                    "properties": {
                      "entities": {
                        "items": {
                          "$ref": "#/$defs/ProjectEntityInput"
                        },
                        "type": "array"
                      },
                      "relations": {
                        "items": {
                          "$ref": "#/$defs/ProjectRelationInput"
                        },
                        "type": "array"
                      }
                    },
                    "type": "object"
                  },
                  "ProjectEntityInput": {
                    "additionalProperties": false,
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "attributes": {
                              "anyOf": [
                                {
                                  "required": [
                                    "feature_id"
                                  ]
                                },
                                {
                                  "required": [
                                    "feature_loop"
                                  ]
                                }
                              ]
                            },
                            "kind": {
                              "const": "work_item"
                            }
                          },
                          "required": [
                            "kind",
                            "attributes"
                          ]
                        },
                        "then": {
                          "properties": {
                            "attributes": {
                              "$ref": "#/$defs/FeatureMetadata"
                            }
                          }
                        }
                      }
                    ],
                    "description": "One canonical project entity authored in a model document.",
                    "properties": {
                      "attributes": {
                        "additionalProperties": {
                          "description": "JSON value"
                        },
                        "type": "object"
                      },
                      "id": {
                        "type": "string"
                      },
                      "kind": {
                        "enum": [
                          "agent",
                          "artifact",
                          "assumption",
                          "claim",
                          "component",
                          "decision",
                          "deployment",
                          "domain_machine",
                          "effect",
                          "environment",
                          "evidence",
                          "gate",
                          "handler",
                          "human",
                          "invariant",
                          "law",
                          "milestone",
                          "obligation",
                          "operation",
                          "package",
                          "protocol",
                          "question",
                          "realization",
                          "responsibility",
                          "runtime",
                          "theory",
                          "type",
                          "work_item"
                        ],
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "status": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "summary": {
                        "type": "string"
                      },
                      "tags": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    },
                    "required": [
                      "id",
                      "kind",
                      "name"
                    ],
                    "type": "object"
                  },
                  "ProjectRelationInput": {
                    "additionalProperties": false,
                    "description": "One canonical project relation authored in a model document.",
                    "properties": {
                      "attributes": {
                        "additionalProperties": {
                          "description": "JSON value"
                        },
                        "type": "object"
                      },
                      "kind": {
                        "enum": [
                          "accountable_for",
                          "assigned_to",
                          "assumes",
                          "blocks",
                          "changes",
                          "conflicts_with",
                          "contains",
                          "covers",
                          "derives",
                          "discharges",
                          "extends",
                          "handles",
                          "hosts",
                          "implements",
                          "informs",
                          "invalidates",
                          "preserves",
                          "provides",
                          "publishes",
                          "reads",
                          "realizes",
                          "refines",
                          "requires",
                          "reviewed_by",
                          "selects",
                          "sends",
                          "supports",
                          "validates",
                          "writes"
                        ],
                        "type": "string"
                      },
                      "source": {
                        "type": "string"
                      },
                      "summary": {
                        "type": "string"
                      },
                      "target": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "source",
                      "target",
                      "kind"
                    ],
                    "type": "object"
                  }
                },
                "$ref": "#/$defs/ProjectDocumentInput",
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "description": "Generated structural projection. Run semproj validate for cross-document semantics.",
                "title": "Semantic Systems project document"
              }
            }
          ],
          "validate": {
            "enable": true
          }
        }
      }
    }
  }
}
